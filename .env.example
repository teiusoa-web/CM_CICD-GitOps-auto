# Copy to .env and adjust. Do not commit .env.

DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Phase 1: set to 1 to run without PostgreSQL (tests / quick local).
# Default 0 = PostgreSQL. Production must never use SQLite.
USE_SQLITE=0

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=devdesk
POSTGRES_USER=devdesk
POSTGRES_PASSWORD=devdesk
